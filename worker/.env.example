# Copy to .env or reuse backend/.env (the worker loads both).
# Never put real credentials in this file or in Git.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_SQS_QUEUE_URL=

# Default works when you run from worker/: go run .
SQLITE_PATH=../backend/database/database.sqlite
