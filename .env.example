# Copy this file to .env and fill in values locally.
# Never put real credentials in this file or in Git.

# Application
APP_NAME="Processador de Documentos Assincrono"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=

# Database — SQLite in the early stages
DB_CONNECTION=sqlite
DB_DATABASE=

# Frontend
VITE_API_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# AWS — never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_SQS_QUEUE_URL=
