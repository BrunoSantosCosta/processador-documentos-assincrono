# Copy this file to .env and fill in values locally.
# Never put real credentials in this file or in Git.

# Application
APP_NAME="Processador de Documentos Assincrono"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=

# Database — SQLite in the early stages
DB_CONNECTION=sqlite
DB_DATABASE=

# Frontend / Docker Compose
# Local:
VITE_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
# On EC2, put the public IPv4 in a root .env (gitignored), for example:
# APP_URL=http://x.x.x.x:8000
# VITE_API_URL=http://x.x.x.x:8000
# CORS_ALLOWED_ORIGINS=http://x.x.x.x:8080

# AWS — never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_SQS_QUEUE_URL=
